\begin{tikzpicture}[>=Triangle]
    % 1. Global spacing variables
    \def\hdist{9em}   % Increased slightly to accommodate wider boxes
    \def\vdist{7em}     % Vertical spacing between models
    \def\sepheight{4em} % Taller separator for the taller boxes

    \tikzset{
        % Style for Identities and Transactions
        smallbox/.style={
            draw,
            minimum width=6em,
            minimum height=2em,
            outer sep=0pt,
            text centered
        },
        % Style for TTP, Counterparty, and Public (Uniform dimensions)
        largebox/.style={
            draw,
            minimum width=6em,
            minimum height=6.5ex,
            align=center,
            outer sep=0pt,
            inner ysep=1ex,
            text centered
        },
        title/.style={
            anchor=south west,
            font=\bfseries,
            inner sep=0pt,
            yshift=1.5em
        },
        sep line/.style={
            draw,
            thin
        }
    }

    % --- TRADITIONAL PRIVACY MODEL ---
    \begin{scope}[local bounding box=Traditional]
        % Nodes
        \node (T-Ident) [smallbox] at (0,0) {Identities};
        \node (T-Trans) [smallbox] at (\hdist, 0) {Transactions};
        \node (T-TTP)   [largebox] at (2*\hdist, 0) {Trusted\\Third Party};
        \node (T-CP)    [largebox] at (3*\hdist, 0) {Counterparty};
        \node (T-Pub)   [largebox] at (4*\hdist, 0) {Public};

        % Title
        \node [title] at (T-Ident.north west) {Traditional Privacy Model};

        % Connections
        \draw (T-Ident) -- (T-Trans);
        \draw [->] (T-Trans) -- (T-TTP);
        \draw [->] (T-TTP) -- (T-CP);

        % Vertical Separator (between Counterparty and Public)
        \draw [sep line] ($(T-CP.east)!0.5!(T-Pub.west) + (0, \sepheight/2)$) 
                      -- ++(0, -\sepheight);
    \end{scope}

    % --- NEW PRIVACY MODEL ---
    \begin{scope}[yshift=-\vdist, local bounding box=New]
        % Nodes
        % Horizontal alignment: Ident(0), Trans(\hdist), Pub(2*\hdist)
        \node (N-Ident) [smallbox] at (0,0) {Identities};
        \node (N-Trans) [smallbox] at (\hdist, 0) {Transactions};
        \node (N-Pub)   [largebox] at (2*\hdist, 0) {Public};

        % Title
        \node [title] at (N-Ident.north west) {New Privacy Model};

        % Connections
        \draw [->] (N-Trans) -- (N-Pub);

        % Vertical Separator (between Identities and Transactions)
        \draw [sep line] ($(N-Ident.east)!0.5!(N-Trans.west) + (0, \sepheight/2)$) 
                      -- ++(0, -\sepheight);
    \end{scope}

\end{tikzpicture}