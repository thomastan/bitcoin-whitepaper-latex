\begin{tikzpicture}[>=Triangle]
    % 1. Global spacing variables
    \def\hsep{0.75em}
    \def\vsep{0.75em}
    \def\arrowlen{3em} % Matching the visual weight of previous entry/exit arrows

    \tikzset{
        box/.style={
            draw,
            minimum height=2em,
            minimum width=3.5em,
            outer sep=0pt,
            text centered
        },
        container/.style={
            draw,
            inner xsep={2*\hsep}, % 1.5em as requested
            inner ysep=\vsep
        }
    }

    % --- STEP 1: INPUT AND OUTPUT NODES ---
    % Left Column (Inputs)
    \node (In1) [box] {In};
    \node (In2) [box, below=\vsep of In1] {In};
    \node (In3) [box, below=\vsep of In2] {...};

    % Right Column (Outputs) - Spaced horizontally by 3*hsep
    \node (Out1) [box] at ($(In1.east) + (3*\hsep, 0)$) {Out};
    \node (Out2) [box, below=\vsep of Out1] {...};

    % --- STEP 2: CONTAINER ---
    % Anchor the container fit with the 1.33em top padding for the label
    \coordinate (TopPad) at ($(In1.north) + (0, 1.33em)$);
    \node (Main) [container, fit=(TopPad)(In3)(Out1)(Out2)] {};

    % --- STEP 3: LABELS AND ARROWS ---
    % Transaction Label (0.33em offsets)
    \node[anchor=north west, xshift=0.33em, yshift=-0.33em, font=\bfseries] 
        at (Main.north west) {Transaction};

    % Input Arrows (Entering from the left)
    \foreach \i in {1,2,3} {
        \draw [<-] (In\i.west) -- ++(-\arrowlen, 0);
    }

    % Output Arrows (Exiting to the right)
    \foreach \i in {1,2} {
        \draw [->] (Out\i.east) -- ++(\arrowlen, 0);
    }

\end{tikzpicture}