\begin{tikzpicture}[>=Triangle]
    % 1. Global spacing variables
    \def\hsep{0.75em}
    \def\vsep{0.75em}
    \def\nodevsep{3.5em}

    \tikzset{
        box/.style={
            draw,
            minimum size=2em,
            text centered,
            outer sep=0pt,
            inner xsep=1ex,
        },
        intermediate_box/.style={
            box,
            dashed,
            text width=3.5em,
            dash pattern=on 2pt off 1.5pt
        },
        container/.style={
            draw,
            inner xsep={\hsep},
            inner ysep={\vsep}
        }
    }

    % --- SCOPE 1: FULL MERKLE TREE ---
    \begin{scope}[xshift=0cm]
        % 1. Top Row (Nonce now 2*hsep to the right)
        \node (P1-PrevHash) [box, minimum width=6em] at (0, 0) {Prev Hash};
        \node (P1-Nonce) [box, minimum width=4em, right={1.66*(\hsep)} of P1-PrevHash] {Nonce};
        
        % 2. Vertical reference (Exactly vsep below Prev Hash bottom)
        \coordinate (P1-HashTopY) at ([yshift=-\vsep]P1-PrevHash.south);
        \coordinate (P1-HdrTop) at ($(P1-PrevHash.north) + (0, 1.33em)$);
        
        % Horizontal midpoint of the boxes themselves
        \coordinate (P1-RowMid) at ($(P1-PrevHash.west)!0.5!(P1-Nonce.east)$);

        % 3. Inner Container (Block Header) - Now 15.2em width
        \coordinate (P1-HdrBottom) at ([yshift=-2em]P1-HashTopY);
        \node (P1-Header) [container, fit=(P1-HdrTop)(P1-PrevHash)(P1-Nonce)(P1-HdrBottom), 
            minimum width=15.2em, inner xsep={2*(\hsep)}] {};
        
        % NW Label for Block Header
        \node[anchor=north west, xshift=0.33em, yshift=-0.33em, font=\bfseries] 
            at (P1-Header.north west) {Block Header (Block Hash)};

        % 4. Root Hash - Centered horizontally in the outer Block (1.75em offset)
        \node (P1-RootHash) [box, minimum width=6em, anchor=north] 
            at ([xshift=-1.75em]P1-RowMid |- P1-HashTopY) {Root Hash};

        % 5. Tree Structure
        \node (P1-Hash01) [intermediate_box] at ($(P1-RootHash.south) + (-3.5em, -\nodevsep)$) {Hash01};
        \node (P1-Hash23) [intermediate_box] at ($(P1-RootHash.south) + (3.5em, -\nodevsep)$) {Hash23};
        \node (P1-Hash0) [intermediate_box, inner xsep=0.5pt, text width=3em] at ($(P1-Hash01.south) + (-1.75em, -\nodevsep)$) {Hash0};
        \node (P1-Hash1) [intermediate_box, inner xsep=0.5pt, text width=3em] at ($(P1-Hash01.south) + (1.75em, -\nodevsep)$) {Hash1};
        \node (P1-Hash2) [intermediate_box, inner xsep=0.5pt, text width=3em] at ($(P1-Hash23.south) + (-1.75em, -\nodevsep)$) {Hash2};
        \node (P1-Hash3) [intermediate_box, inner xsep=0.5pt, text width=3em] at ($(P1-Hash23.south) + (1.75em, -\nodevsep)$) {Hash3};

        % 6. Transactions
        \node (P1-Tx0) [box, below=2.5em of P1-Hash0] {Tx0};
        \node (P1-Tx1) [box, below=2.5em of P1-Hash1] {Tx1};
        \node (P1-Tx2) [box, below=2.5em of P1-Hash2] {Tx2};
        \node (P1-Tx3) [box, below=2.5em of P1-Hash3] {Tx3};

        % 7. Connections
        \foreach \j in {0,1,2,3} { \draw [->] (P1-Tx\j) -- (P1-Hash\j); }
        \draw [->] (P1-Hash0.north) -- ([xshift=-0.5em]P1-Hash01.south);
        \draw [->] (P1-Hash1.north) -- ([xshift=0.5em]P1-Hash01.south);
        \draw [->] (P1-Hash2.north) -- ([xshift=-0.5em]P1-Hash23.south);
        \draw [->] (P1-Hash3.north) -- ([xshift=0.5em]P1-Hash23.south);
        \draw [->] (P1-Hash01.north) -- ([xshift=-1.5em]P1-RootHash.south);
        \draw [->] (P1-Hash23.north) -- ([xshift=1.5em]P1-RootHash.south);

        % 8. Outer Container
        \coordinate (P1-LPad) at ($(P1-Header.west) - (3.5em, 0)$);
        \node (P1-Block) [container, fit=(P1-LPad)(P1-Header)(P1-Tx0)(P1-Tx3)] {};
        
        \node[anchor=north west, xshift=0.33em, yshift=-0.33em, font=\bfseries] 
            at (P1-Block.north west) {Block};

        \node [below=1ex of P1-Block] {Transactions Hashed in a Merkle Tree};
    \end{scope}

    % --- SCOPE 2: PRUNED TREE (Now 20em to the right) ---
    \begin{scope}[xshift=55ex]
        \node (P2-PrevHash) [box, minimum width=6em] at (0, 0) {Prev Hash};
        \node (P2-Nonce) [box, minimum width=4em, right={1.66*(\hsep)} of P2-PrevHash] {Nonce};
        
        \coordinate (P2-HashTopY) at ([yshift=-\vsep]P2-PrevHash.south);
        \coordinate (P2-HdrTop) at ($(P2-PrevHash.north) + (0, 1.33em)$);
        \coordinate (P2-RowMid) at ($(P2-PrevHash.west)!0.5!(P2-Nonce.east)$);
        \coordinate (P2-HdrBottom) at ([yshift=-2em]P2-HashTopY);

        \node (P2-Header) [container, fit=(P2-HdrTop)(P2-PrevHash)(P2-Nonce)(P2-HdrBottom), 
            minimum width=15.2em, inner xsep={2*(\hsep)}] {};
        
        \node[anchor=north west, xshift=0.33em, yshift=-0.33em, font=\bfseries] 
            at (P2-Header.north west) {Block Header (Block Hash)};

        \node (P2-RootHash) [box, minimum width=6em, anchor=north] 
            at ([xshift=-1.75em]P2-RowMid |- P2-HashTopY) {Root Hash};

        \node (P2-Hash01) [box, text width=3.5em] at ($(P2-RootHash.south) + (-3.5em, -\nodevsep)$) {Hash01};
        \node (P2-Hash23) [intermediate_box, text width=3.5em] at ($(P2-RootHash.south) + (3.5em, -\nodevsep)$) {Hash23};
        \node (P2-Hash2) [box, inner xsep=0.5pt, text width=3em] at ($(P2-Hash23.south) + (-1.75em, -\nodevsep)$) {Hash2};
        \node (P2-Hash3) [intermediate_box, inner xsep=0.5pt, text width=3em] at ($(P2-Hash23.south) + (1.75em, -\nodevsep)$) {Hash3};
        \node (P2-Tx3) [box, below=2.5em of P2-Hash3] {Tx3};

        \draw [->] (P2-Tx3) -- (P2-Hash3);
        \draw [->] (P2-Hash2.north) -- ([xshift=-0.5em]P2-Hash23.south);
        \draw [->] (P2-Hash3.north) -- ([xshift=0.5em]P2-Hash23.south);
        \draw [->] (P2-Hash01.north) -- ([xshift=-1.5em]P2-RootHash.south);
        \draw [->] (P2-Hash23.north) -- ([xshift=1.5em]P2-RootHash.south);

        \coordinate (P2-LPad) at ($(P2-Header.west) - (3.5em, 0)$);
        \node (P2-Block) [container, fit=(P2-LPad)(P2-Header)(P2-Hash01)(P2-Tx3)] {};
        
        \node[anchor=north west, xshift=0.33em, yshift=-0.33em, font=\bfseries] 
            at (P2-Block.north west) {Block};

        \node [below=1ex of P2-Block] {After Pruning Tx0-2 from the Block};
    \end{scope}

\end{tikzpicture}