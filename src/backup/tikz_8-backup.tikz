\begin{tikzpicture}[>=Triangle]
    % 1. Global spacing variables
    \def\hsep{0.75em}
    \def\vsep{0.75em}
    \def\nodevsep{3em}
    \def\blockdist{42ex}

    \tikzset{
        box/.style={
            draw,
            minimum size=2em,
            text centered,
            outer sep=0pt,
            inner xsep=1ex,
        },
        intermediate_box/.style={
            box,
            dashed,
            text width=3.5em,
            dash pattern=on 2pt off 1.5pt
        },
        container/.style={
            draw,
            inner xsep={\hsep},
            inner ysep={\vsep}
        }
    }

    % --- BLOCK 1 (Left) ---
    \begin{scope}[xshift=-\blockdist]
        \node (B1-PH) [box, minimum width=6em] at (0, 0) {Prev Hash};
        \node (B1-N) [box, minimum width=4em, right={1.66*(\hsep)} of B1-PH] {Nonce};
        
        \coordinate (B1-RowMid) at ($(B1-PH.west)!0.5!(B1-N.east)$);
        \coordinate (B1-HashTopY) at ([yshift=-\vsep]B1-PH.south);
        \coordinate (B1-HdrTop) at ($(B1-PH.north) + (0, 1.33em)$);

        \node (B1-MT) [box, minimum width=6em, anchor=north] 
            at ([xshift=-1.75em]B1-RowMid |- B1-HashTopY) {Merkle Tree};

        \node (B1-Header) [container, fit=(B1-HdrTop)(B1-PH)(B1-N)(B1-MT), 
            minimum width=15.2em, inner xsep={2*(\hsep)}] {};
        
        \node[anchor=north west, xshift=0.33em, yshift=-0.33em, font=\bfseries] 
            at (B1-Header.north west) {Block Header};
    \end{scope}

    % --- BLOCK 2 (Middle) ---
    \begin{scope}[xshift=0cm]
        \node (B2-PH) [box, minimum width=6em] at (0, 0) {Prev Hash};
        \node (B2-N) [box, minimum width=4em, right={1.66*(\hsep)} of B2-PH] {Nonce};
        
        \coordinate (B2-RowMid) at ($(B2-PH.west)!0.5!(B2-N.east)$);
        \coordinate (B2-HashTopY) at ([yshift=-\vsep]B2-PH.south);
        \coordinate (B2-HdrTop) at ($(B2-PH.north) + (0, 1.33em)$);

        \node (B2-MT) [box, minimum width=6em, anchor=north] 
            at ([xshift=-1.75em]B2-RowMid |- B2-HashTopY) {Merkle Tree};

        \node (B2-Header) [container, fit=(B2-HdrTop)(B2-PH)(B2-N)(B2-MT), 
            minimum width=15.2em, inner xsep={2*(\hsep)}] {};
        
        \node[anchor=north west, xshift=0.33em, yshift=-0.33em, font=\bfseries] 
            at (B2-Header.north west) {Block Header};

        % Tree Structure
        \node (B2-H01) [box, text width=3.5em] at ($(B2-MT.south) + (-3.5em, -\nodevsep)$) {Hash01};
        \node (B2-H23) [intermediate_box, text width=3.5em] at ($(B2-MT.south) + (3.5em, -\nodevsep)$) {Hash23};
        \node (B2-H2) [box, inner xsep=0.5pt, text width=3em] at ($(B2-H23.south) + (-1.75em, -\nodevsep)$) {Hash2};
        \node (B2-H3) [intermediate_box, inner xsep=0.5pt, text width=3em] at ($(B2-H23.south) + (1.75em, -\nodevsep)$) {Hash3};
        \node (B2-Tx3) [box, below=2.5em of B2-H3] {Tx3};

        % Connections
        \draw [->] (B2-Tx3) -- (B2-H3);
        \draw [->] (B2-H2.north) -- ([xshift=-0.5em]B2-H23.south);
        \draw [->] (B2-H3.north) -- ([xshift=0.5em]B2-H23.south);
        \draw [->] (B2-H01.north) -- ([xshift=-1.5em]B2-MT.south);
        \draw [->] (B2-H23.north) -- ([xshift=1.5em]B2-MT.south);

        % Merkle Branch Annotation (Your specific placement)
        \node[anchor=west] (BranchLabel) at ([xshift=1.5em]$(B2-H23.south)!0.5!(B2-H3.north)$) {Merkle Branch for Tx3};
    \end{scope}

    % --- BLOCK 3 (Right) ---
    \begin{scope}[xshift=\blockdist]
        \node (B3-PH) [box, minimum width=6em] at (0, 0) {Prev Hash};
        \node (B3-N) [box, minimum width=4em, right={1.66*(\hsep)} of B3-PH] {Nonce};
        
        \coordinate (B3-RowMid) at ($(B3-PH.west)!0.5!(B3-N.east)$);
        \coordinate (B3-HashTopY) at ([yshift=-\vsep]B3-PH.south);
        \coordinate (B3-HdrTop) at ($(B3-PH.north) + (0, 1.33em)$);

        \node (B3-MT) [box, minimum width=6em, anchor=north] 
            at ([xshift=-1.75em]B3-RowMid |- B3-HashTopY) {Merkle Tree};

        \node (B3-Header) [container, fit=(B3-HdrTop)(B3-PH)(B3-N)(B3-MT), 
            minimum width=15.2em, inner xsep={2*(\hsep)}] {};
        
        \node[anchor=north west, xshift=0.33em, yshift=-0.33em, font=\bfseries] 
            at (B3-Header.north west) {Block Header};
    \end{scope}

    % --- TRANSITION ARROWS ---
    \path let \p1 = ($ (B2-PH.west) - (B1-Header.east) $), \n1 = {abs(\x1)} in 
        coordinate (gap) at (\n1, 0);

    % Entering arrow
    \draw [->, thick] let \p1 = (gap) in ([xshift=-\x1]B1-PH.west) coordinate (ArrowStart) -- (B1-PH.west);

    % Inter-block arrows
    \draw [->, thick] (B1-Header.east |- B2-PH.west) -- (B2-PH.west);
    \draw [->, thick] (B2-Header.east |- B3-PH.west) -- (B3-PH.west);

    % Leaving arrow
    \draw [->, thick] let \p1 = (gap) in (B3-Header.east |- B3-PH) -- ++(\x1, 0) coordinate (ArrowEnd);

    % --- ANNOTATIONS ---
    \node (MainTitle) [anchor=south west, font=\bfseries] at ([yshift={\vsep/3}]B1-Header.north -| ArrowStart) {Longest Proof-of-Work Chain};

    % --- BALANCING BOUNDING BOX (Invisible, 3pt inner sep) ---
    % Removed 'draw' option to hide the solid line.
    \node [fit=(MainTitle)(B2-Tx3)(ArrowStart)(ArrowEnd)(BranchLabel), inner xsep=3pt] (BoundingBox) {};

\end{tikzpicture}